<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Planillas</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaPlanillas.styles.css" asp-append-version="true" />
</head>

<body>

    <!-- FRANJA SUPERIOR -->
    <header class="topbar">

        <div class="logo-area">

            <img src="~/images/logo-hojancha.png"
                 alt="Logo Municipalidad"
                 class="logo-muni" />

            
        <div class="texto-muni">

            <div class="municipalidad">
                MUNICIPALIDAD DE
            </div>

            <div class="hojancha">
                HOJANCHA
            </div>

            <div class="subtitulo-muni">
                Tierra de gente buena
            </div>

        </div>

         </div>

    <div class="top-links">
        <span>Servicio</span>
        <span>•</span>
        <span>Transparencia</span>
        <span>•</span>
        <span>Desarrollo</span>
    </div>

    </header>

    <!-- CUERPO -->
    <div class="d-flex">

        <!-- MENÚ LATERAL -->
        <div class="bg-primary text-white p-3"
             style="width:240px; min-height:calc(100vh - 90px);">

            <ul class="nav flex-column">

                <li class="nav-item mb-2">
                    <a class="nav-link text-white"
                       asp-controller="Home"
                       asp-action="Index">

                       <img src="~/images/pagina-de-inicio.png"
         class="menu-icon" />

                         Inicio
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a class="nav-link text-white"
                       asp-controller="Empleado"
                       asp-action="Index">

                       <img src="~/images/empleado.png"
         class="menu-icon" />

                          Empleados
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a class="nav-link text-white"
                       asp-controller="Puesto"
                       asp-action="Index">

                       <img src="~/images/maletin.png"
         class="menu-icon" />

                         Puestos
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a class="nav-link text-white"
                       asp-controller="Departamento"
                       asp-action="Index">

                       <img src="~/images/Departamentos.png"
         class="menu-icon" />

                         Departamentos
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a class="nav-link text-white"
                       asp-controller="Vacaciones"
                       asp-action="Index">

                        <img src="~/images/calendario.png"
                             class="menu-icon" />

                        Vacaciones
                    </a>
                </li>

                <li class="nav-item mb-2">
    <a class="nav-link text-white"
       asp-controller="Reportes"
       asp-action="Index">

                       <img src="~/images/reporte.png"
         class="menu-icon" />

        Reportes

    </a>
</li>

<li class="nav-item mb-2">
    <a class="nav-link text-white"
       asp-controller="Configuracion"
       asp-action="Index">
        
                       <img src="~/images/Configuracion.png"
         class="menu-icon" />

      Configuración

    </a>
</li>
            </ul>

        </div>

        <!-- CONTENIDO -->
        <div class="container-fluid p-4">

            @RenderBody()

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>