@model List<SistemaPlanillas.Models.Vacacion>

@{
    ViewData["Title"] = "Vacaciones";
}

<h2>Vacaciones</h2>

<table class="table table-striped table-hover table-bordered">

    <thead class="table-primary">

        <tr>
            <th>ID</th>
            <th>Empleado</th>
            <th>Fecha Inicio</th>
            <th>Fecha Fin</th>
            <th>Días</th>
            <th>Observaciones</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var vacacion in Model)
        {
            <tr>

                <td>@vacacion.IdVacacion</td>

                <td>@vacacion.IdEmpleado</td>

                <td>@vacacion.FechaInicio.ToShortDateString()</td>

                <td>@vacacion.FechaFin.ToShortDateString()</td>

                <td>@vacacion.DiasSolicitados</td>

                <td>@vacacion.Observaciones</td>

                <td>

                    @if (vacacion.Estado == "Aprobada")
                    {
                        <span class="badge bg-success">
                            Aprobada
                        </span>
                    }
                    else if (vacacion.Estado == "Rechazada")
                    {
                        <span class="badge bg-danger">
                            Rechazada
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            Pendiente
                        </span>
                    }

                </td>
               

                <td>

                    <a asp-action="Aprobar"
                       asp-route-id="@vacacion.IdVacacion"
                       class="btn btn-success btn-sm">
                        Aprobar
                    </a>

                    <a asp-action="Rechazar"
                       asp-route-id="@vacacion.IdVacacion"
                       class="btn btn-danger btn-sm">
                        Rechazar
                    </a>

                </td>
            </tr>
        }

    </tbody>

</table>
